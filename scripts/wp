#!/bin/bash
# WP-CLI wrapper for Local by Flywheel sites
#
# Auto-detects the site from CWD by matching against sites.json paths.
# Falls back to -s <name> or --site=<name> if CWD is not inside a Local site.
# Supports fuzzy matching for partial site names (case-insensitive).
#
# Usage:
#   wp <wp-cli-command...>          # auto-detect site from CWD
#   wp -s <name> <command...>       # explicit site (shorthand)
#   wp --site=<name> <command...>   # explicit site
#   wp --list                       # show all sites with status

set -euo pipefail

LOCAL_BASE="$HOME/Library/Application Support/Local"
SITES_JSON="$LOCAL_BASE/sites.json"
STATUSES_JSON="$LOCAL_BASE/site-statuses.json"
ARCH="$(uname -m)"

if [[ "$ARCH" == "arm64" ]]; then
  ARCH_DIR="darwin-arm64"
else
  ARCH_DIR="darwin"
fi

# Locate WP-CLI phar
WP_CLI_BIN=$(command -v wp 2>/dev/null || true)
if [[ -z "$WP_CLI_BIN" ]]; then
  echo "Error: wp (WP-CLI) not found in PATH." >&2
  exit 1
fi

if [[ ! -f "$SITES_JSON" ]]; then
  echo "Error: Local by Flywheel sites file not found at $SITES_JSON." >&2
  echo "Install Local and create at least one site, then try again." >&2
  exit 1
fi

# ── Helpers ──────────────────────────────────────────────────────────
# Values are passed to Python as argv/env, never spliced into the source,
# so site names containing quotes or glob characters are handled safely.

list_sites() {
  python3 - "$SITES_JSON" "$STATUSES_JSON" <<'PY'
import json, os, sys

sites_path, statuses_path = sys.argv[1], sys.argv[2]

with open(sites_path) as f:
    sites = json.load(f)

statuses = {}
if os.path.exists(statuses_path):
    with open(statuses_path) as f:
        statuses = json.load(f)

for s in sorted(sites.values(), key=lambda x: x['name']):
    status = statuses.get(s['id'], 'unknown')
    marker = '●' if status == 'running' else '○'
    print(f"  {marker} {s['name']:20s} {status:10s} {s['path']}")
PY
}

# Resolve a site and print one tab-separated line:
#   id <TAB> name <TAB> path <TAB> php_version <TAB> db_version <TAB> db_engine
# Mode "cwd": longest sites.json path that contains the current directory.
# Mode "name": exact name match, else a single case-insensitive substring match.
resolve_site() {
  local mode="$1"
  local query="${2:-}"
  python3 - "$SITES_JSON" "$mode" "$query" "$PWD" <<'PY'
import json, sys

sites_path, mode, query, cwd = sys.argv[1:5]

with open(sites_path) as f:
    sites = list(json.load(f).values())

def emit(s):
    print("\t".join([
        s['id'],
        s['name'],
        s['path'],
        s['services']['php']['version'],
        s['services']['mysql']['version'],
        # Service name Local recorded (e.g. "mysql"); used to pick the folder.
        s['services']['mysql'].get('name', 'mysql'),
    ]))

if mode == "cwd":
    best, best_len = None, 0
    for s in sites:
        p = s['path'].rstrip('/')
        # CWD must equal the site path or be a subdirectory of it
        if (cwd == p or cwd.startswith(p + '/')) and len(p) > best_len:
            best, best_len = s, len(p)
    if best is None:
        sys.exit(1)
    emit(best)
    sys.exit(0)

exact = [s for s in sites if s['name'] == query]
if exact:
    emit(exact[0])
    sys.exit(0)

needle = query.lower()
matches = [s for s in sites if needle in s['name'].lower()]
if len(matches) == 1:
    emit(matches[0])
    sys.exit(0)
if len(matches) > 1:
    print(f'Ambiguous match for "{query}". Did you mean:', file=sys.stderr)
    for m in matches:
        print(f"  - {m['name']}", file=sys.stderr)
sys.exit(1)
PY
}

# Print the newest installed lightning-services folder for a component,
# e.g. find_service php 8.3.23 -> .../php-8.3.23+0
# Local names folders "<component>-<version>+<build>", so the "+" anchors the
# version and "8.2.2" can no longer match "8.2.27+1".
find_service() {
  local component="$1"
  local version="$2"
  # "|| true": a missing folder should reach the friendly error, not exit silently.
  find "$LOCAL_BASE/lightning-services" -maxdepth 1 -type d -name "${component}-${version}+*" 2>/dev/null | sort | tail -1 || true
}

check_site_status() {
  local site_id="$1"
  local site_name="$2"
  python3 - "$STATUSES_JSON" "$site_id" "$site_name" <<'PY'
import json, os, sys

statuses_path, site_id, site_name = sys.argv[1:4]

if not os.path.exists(statuses_path):
    sys.exit(0)

with open(statuses_path) as f:
    statuses = json.load(f)

status = statuses.get(site_id, 'unknown')
if status != 'running':
    print(f'Warning: Site "{site_name}" is {status}. It may need to be started in Local.', file=sys.stderr)
PY
}

# ── Parse arguments ──────────────────────────────────────────────────

SITE_NAME=""

# Handle --list
if [[ "${1:-}" == "--list" ]]; then
  echo "Local by Flywheel sites:"
  echo ""
  list_sites
  exit 0
fi

# Handle -s <name> shorthand
if [[ "${1:-}" == "-s" ]]; then
  if [[ -z "${2:-}" ]]; then
    echo "Error: -s requires a site name." >&2
    exit 1
  fi
  SITE_NAME="$2"
  shift 2
fi

# Handle --site=<name>
if [[ "${1:-}" == --site=* ]]; then
  SITE_NAME="${1#--site=}"
  shift
fi

# ── Resolve site ─────────────────────────────────────────────────────

SITE_INFO=""

if [[ -n "$SITE_NAME" ]]; then
  SITE_INFO=$(resolve_site name "$SITE_NAME") || {
    echo "Error: Site '$SITE_NAME' not found in Local by Flywheel." >&2
    echo "" >&2
    echo "Available sites:" >&2
    list_sites >&2
    exit 1
  }
else
  SITE_INFO=$(resolve_site cwd 2>/dev/null) || true

  if [[ -z "$SITE_INFO" ]]; then
    if [[ $# -eq 0 ]]; then
      echo "Usage: wp [-s <name> | --site=<name>] <wp-cli-command...>"
      echo "       wp --list"
      echo ""
      echo "Run from inside a Local site directory for auto-detection,"
      echo "or use --site=<name> to specify explicitly."
      echo ""
      echo "Available sites:"
      list_sites
      exit 0
    else
      echo "Error: Could not auto-detect site from current directory." >&2
      echo "Use -s <name>, --site=<name>, or cd into a Local site directory." >&2
      echo "" >&2
      echo "Available sites:" >&2
      list_sites >&2
      exit 1
    fi
  fi
fi

IFS=$'\t' read -r SITE_ID SITE_NAME SITE_PATH PHP_VER MYSQL_VER DB_ENGINE <<< "$SITE_INFO"

# Expand ~ in site path
SITE_PATH="${SITE_PATH/#\~/$HOME}"

WP_PATH="$SITE_PATH/app/public"

# ── Warn if site is not running ──────────────────────────────────────

check_site_status "$SITE_ID" "$SITE_NAME"

# ── Resolve PHP binary ───────────────────────────────────────────────

PHP_BASE=$(find_service php "$PHP_VER")
if [[ -z "$PHP_BASE" ]]; then
  echo "Error: Could not find PHP $PHP_VER in Local lightning-services." >&2
  exit 1
fi
PHP_BIN="$PHP_BASE/bin/$ARCH_DIR/bin/php"
if [[ ! -x "$PHP_BIN" ]]; then
  echo "Error: PHP binary not found or not executable at $PHP_BIN" >&2
  exit 1
fi

# ── Resolve MySQL/MariaDB binary directory ────────────────────────────

MYSQL_BASE=$(find_service "$DB_ENGINE" "$MYSQL_VER")
if [[ -z "$MYSQL_BASE" ]]; then
  echo "Error: Could not find $DB_ENGINE $MYSQL_VER in Local lightning-services." >&2
  exit 1
fi
MYSQL_BIN_DIR="$MYSQL_BASE/bin/$ARCH_DIR/bin"
if [[ ! -d "$MYSQL_BIN_DIR" ]]; then
  echo "Error: $DB_ENGINE binaries not found at $MYSQL_BIN_DIR" >&2
  echo "Open the site once in Local so it downloads the database service." >&2
  exit 1
fi

# ── Site-specific php.ini ─────────────────────────────────────────────

PHP_INI="$LOCAL_BASE/run/$SITE_ID/conf/php/php.ini"

if [[ ! -f "$PHP_INI" ]]; then
  echo "Error: php.ini not found at $PHP_INI" >&2
  echo "Is the '$SITE_NAME' site running in Local?" >&2
  exit 1
fi

# ── MySQL client config (socket, credentials) ────────────────────────

MYSQL_CONF_DIR="$LOCAL_BASE/run/$SITE_ID/conf/mysql"
if [[ -f "$MYSQL_CONF_DIR/my.cnf" ]]; then
  export MYSQL_HOME="$MYSQL_CONF_DIR"
fi

MYSQL_SOCKET="$LOCAL_BASE/run/$SITE_ID/mysql/mysqld.sock"
if [[ -S "$MYSQL_SOCKET" ]]; then
  export MYSQL_UNIX_PORT="$MYSQL_SOCKET"
fi

# ── Execute WP-CLI ────────────────────────────────────────────────────

export PATH="$MYSQL_BIN_DIR:$PATH"

echo "[$SITE_NAME] wp $*" >&2

exec "$PHP_BIN" -c "$PHP_INI" "$WP_CLI_BIN" --path="$WP_PATH" "$@"
